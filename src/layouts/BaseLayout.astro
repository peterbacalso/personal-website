---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: object;
}

const { title, description = 'ML engineer — Peter Bacalso', ogType = 'website', jsonLd } = Astro.props;
const canonicalUrl = Astro.url.href;
const ogImageUrl = new URL('/og-image.jpg', Astro.site).href;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Peter Bacalso" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-white text-gray-900 font-sans antialiased flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none">
      Skip to content
    </a>
    <header class="max-w-2xl mx-auto px-4 py-8 flex justify-between items-center w-full">
      <a href="/" class="font-semibold text-lg hover:text-gray-600 transition-colors">
        Peter Bacalso
      </a>
      <nav class="flex gap-6 text-sm">
        <a href="/" class={path === '/' ? 'font-medium text-gray-900' : 'text-gray-500 hover:text-gray-700 transition-colors'}>About</a>
        <a href="/blog" class={path.startsWith('/blog') ? 'font-medium text-gray-900' : 'text-gray-500 hover:text-gray-700 transition-colors'}>Blog</a>
      </nav>
    </header>
    <main id="main-content" class="max-w-2xl mx-auto px-4 py-8 flex-1 w-full">
      <slot />
    </main>
    <footer class="max-w-2xl mx-auto px-4 py-8 text-sm text-gray-500 border-t border-gray-100 w-full">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-4">
          <span>© {new Date().getFullYear()} Peter Bacalso</span>
          <div class="flex items-center gap-3">
            <a
              href="https://github.com/peterbacalso"
              aria-label="GitHub"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-gray-700 transition-colors"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.929.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
            <a
              href="https://linkedin.com/in/peterbacalso"
              aria-label="LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-gray-700 transition-colors"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </div>
        </div>
        <nav class="flex gap-4">
          <a href="/blog" class="hover:text-gray-700 transition-colors">Blog</a>
          <a href="/sitemap-index.xml" class="hover:text-gray-700 transition-colors">Sitemap</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
