---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="This page doesn't exist.">
  <div class="text-center py-20">
    <p class="text-6xl font-bold text-gray-200 mb-4">404</p>
    <h1 class="text-2xl font-bold mb-2">Page not found</h1>
    <p class="text-gray-500 mb-8">This page doesn't exist or was moved.</p>
    <a href="/" class="text-gray-700 hover:text-gray-500 transition-colors underline">
      Go home
    </a>
  </div>
</BaseLayout>
