---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/me.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Peter Bacalso',
  url: 'https://peterbacalso.com',
  sameAs: [
    'https://github.com/peterbacalso',
    'https://linkedin.com/in/peterbacalso',
  ],
};
---

<BaseLayout title="Peter Bacalso — ML Engineer" jsonLd={jsonLd}>
  <section class="flex flex-col sm:flex-row gap-8 items-start">
    <Image
      src={profilePhoto}
      alt="Peter Bacalso"
      width={320}
      height={320}
      quality={95}
      class="rounded-full shrink-0 object-cover w-40 h-40"
      style="object-position: 50% 20%"
    />
    <div>
      <h1 class="text-2xl font-bold mb-2">Peter Bacalso</h1>
      <p class="text-gray-600 mb-4 leading-relaxed">
        Hello World! I'm an AI/ML engineer based in Austin <a href="https://instagram.com/peterb.dance" target="_blank" rel="noopener noreferrer" class="text-gray-700 hover:text-gray-500 transition-colors underline">(Toronto originally)</a>. I've built ML systems across the full lifecycle over the last six years. These days I'm deep in the modern LLM stack, working on agentic workflows and infrastructure.
      </p>
      <p class="text-gray-600 leading-relaxed">
        Outside of work, I enjoy dancing <a href="https://instagram.com/peterb.dance" target="_blank" rel="noopener noreferrer" class="text-gray-700 hover:text-gray-500 transition-colors underline">@peterb.dance</a>, bouldering, paddleboarding, playing video games or watching movies and hunting for good places to eat.
      </p>
    </div>
  </section>
</BaseLayout>
